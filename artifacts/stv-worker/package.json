{
  "name": "@workspace/stv-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "wrangler d1 create stv-shop",
    "db:migrate:local": "wrangler d1 migrations apply stv-shop --local",
    "db:migrate:remote": "wrangler d1 migrations apply stv-shop --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "~5.9.3",
    "wrangler": "4.147.0"
  }
}
